# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DB_NAME=fixitpro
DB_USER=fixitpro_user
DB_PASSWORD=changeme_local_only
MYSQL_ROOT_PASSWORD=rootpass_local_only

# --- JWT ---
# Generate a strong random secret, e.g.: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_base64_secret

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI (Phase 5) ---
# Free tier via https://console.groq.com - no credit card required.
# Uses openai/gpt-oss-120b by default (see services/ai-chat-service/src/main/resources/application.yml).
GROQ_API_KEY=